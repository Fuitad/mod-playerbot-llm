# Local configuration: only the .dist template is tracked.
conf/*.conf

# Secrets and environment files. Tokens and API keys live only in the
# process environment, never in tracked files.
.env
.env.*

# Python caches and virtual environments.
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.ruff_cache/

# Legacy sidecar SQLite files, left by versions before the move to the shared
# Playerbots database. Nothing writes these any more; ignored so an unremoved
# leftover on a developer machine cannot be committed by accident.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Build artifacts.
build/
*.o
*.a

# OS noise.
.DS_Store

# graphify knowledge graph output.
graphify-out/
